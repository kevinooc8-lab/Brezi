name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [main, master]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Siapkan platform Android
        run: |
          flutter create --platforms=android --org com.contohmu --project-name belajar_jerman .
          rm -rf test

      - name: Pasang Firebase (jika google-services.json ada)
        run: |
          python3 - <<'PY'
          import os, re, shutil
          if not os.path.exists('google-services.json'):
              print('google-services.json tidak ada, lewati Firebase')
              raise SystemExit
          shutil.copy('google-services.json', 'android/app/google-services.json')
          def edit(path, fn):
              if os.path.exists(path):
                  s = open(path, encoding='utf-8').read()
                  open(path, 'w', encoding='utf-8').write(fn(s))
          def settings(s):
              if 'google-services' in s:
                  return s
              out = []
              for line in s.split('\n'):
                  out.append(line)
                  if 'com.android.application' in line and 'apply false' in line:
                      new = line.replace('com.android.application', 'com.google.gms.google-services')
                      out.append(re.sub(r'version\s*"[^"]+"', 'version "4.4.2"', new))
              return '\n'.join(out)
          def app(s):
              if 'google-services' not in s:
                  out = []
                  for line in s.split('\n'):
                      out.append(line)
                      if 'com.android.application' in line and 'version' not in line and 'apply false' not in line:
                          out.append(line.replace('com.android.application', 'com.google.gms.google-services'))
                  s = '\n'.join(out)
              return re.sub(r'(minSdk(?:Version)?\s*=?\s*)flutter\.minSdkVersion', r'\g<1>24', s)
          for f in ('android/settings.gradle.kts', 'android/settings.gradle'):
              edit(f, settings)
          for f in ('android/app/build.gradle.kts', 'android/app/build.gradle'):
              edit(f, app)
          PY

      - run: flutter pub get
      - run: flutter build apk --release

      - uses: actions/upload-artifact@v4
        with:
          name: belajar-jerman-apk
          path: build/app/outputs/flutter-apk/app-release.apk
